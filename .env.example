# ---- Mode -------------------------------------------------------------
# The desk ALWAYS starts in paper. Switch to live with the dashboard's "Go LIVE" button
# (you type LIVE to confirm), and back with "Back to PAPER".
TZ_MODE=paper
# Price source. auto (default) = REAL market data, for paper and live alike:
# Alpaca if keys are set, otherwise Coinbase (crypto, no key needed).
# sim = synthetic prices, only for offline demos/tests.
TZ_FEED=auto
# Broker used in PAPER mode: paper (internal simulator) | alpaca (Alpaca paper account)
TZ_BROKER=paper
# Empty = default for the feed (Coinbase: BTC, ETH, SOL, XRP, AVAX, LINK; Alpaca: crypto + AAPL, NVDA, TSLA)
TZ_SYMBOLS=
# Indicators run on bars of this many seconds when trading real data (stops still act on every tick)
TZ_BAR_SECONDS=15
TZ_STARTING_CASH=100000
TZ_CYCLE_SECONDS=1

# Protect the dashboard and control API. Required before going live if the server
# listens on anything other than localhost (TZ_HOST).
TZ_API_TOKEN=

# ---- Alpaca ------------------------------------------------------------
# Paper-account keys (optional: for TZ_BROKER=alpaca and/or TZ_FEED=alpaca)
TZ_ALPACA_KEY=
TZ_ALPACA_SECRET=
# LIVE (real money) account keys - setting these enables the Go LIVE button
TZ_ALPACA_LIVE_KEY=
TZ_ALPACA_LIVE_SECRET=
# Most USD the bots may trade with in live mode, even if the account holds more (0 = no cap)
TZ_LIVE_MAX_CAPITAL=0

# ---- Risk Manager ------------------------------------------------------
TZ_RISK_PER_TRADE=0.01
TZ_MAX_POSITION_PCT=0.20
TZ_MAX_GROSS_EXPOSURE=1.0
TZ_MAX_OPEN_POSITIONS=5
TZ_MAX_DAILY_LOSS_PCT=0.05
TZ_MAX_DRAWDOWN_PCT=0.15
TZ_MAX_ORDERS_PER_MINUTE=30
TZ_MIN_SIGNAL_STRENGTH=0.35
TZ_SYMBOL_COOLDOWN_S=10
TZ_ALLOW_SHORT=false
# Buys need team consensus: nobody objects and at least this many voters agree
TZ_CONSENSUS_MIN_YES=2
TZ_FRACTIONAL=true

# Max total loss if every open stop were hit, as a fraction of equity
TZ_MAX_PORTFOLIO_HEAT=0.05

# ---- Stop-loss placement ------------------------------------------------
# structure = just beyond the recent swing low/high (the commonly used level) | atr = fixed ATR multiple
TZ_STOP_METHOD=structure
TZ_STOP_BUFFER_ATR=1.0
TZ_MIN_STOP_ATR=1.5
# Skip trades whose swing stop is wider than this many ATR
TZ_MAX_STOP_ATR=4.0
# Target = this x stop distance; need at least min_room_r of room before resistance
TZ_REWARD_RISK=2.0
TZ_MIN_ROOM_R=1.0

# ---- Portfolio Manager exits ------------------------------------------
TZ_STOP_ATR_MULT=3
TZ_TAKE_PROFIT_ATR_MULT=6
TZ_TRAILING_STOP=true

# ---- Profit protection (a trade that went green must not end red) ----------
# Arm when open profit reaches this multiple of the initial risk; stop moves to break-even + costs
TZ_BREAKEVEN_TRIGGER_R=0.5
# Then lock in this share of the peak open profit
TZ_PROFIT_LOCK_PCT=0.5
# Take partial profit at +1R on half the position (0 disables)
TZ_SCALE_OUT_R=1.0
TZ_SCALE_OUT_FRACTION=0.5
# Strategy-driven exits only when net profitable (stop-losses still cut losers)
TZ_EXIT_ONLY_IN_PROFIT=true

# ---- Grok (xAI) AI analyst --------------------------------------------
TZ_GROK_API_KEY=
TZ_GROK_MODEL=grok-4
# auto = veto when a key is set, else off | veto | advisory | off
TZ_GROK_MODE=auto
TZ_GROK_FAIL_OPEN=false
TZ_GROK_TIMEOUT_S=20
TZ_GROK_MAX_SIGNAL_AGE_S=30

# ---- Execution accuracy -----------------------------------------------
# worse fills pause trading
TZ_MAX_SLIPPAGE_BPS=50

# ---- Wallets / funding ------------------------------------------------
# The desk's own receiving addresses, CHAIN:address, comma-separated
TZ_DEPOSIT_ADDRESSES=
TZ_WITHDRAWAL_COOLDOWN_H=24
TZ_MAX_DAILY_WITHDRAWAL=10000
