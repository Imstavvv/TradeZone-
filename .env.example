# ---- Mode -------------------------------------------------------------
# The desk ALWAYS starts in paper. Switch to live with the dashboard's "Go LIVE" button
# (you type LIVE to confirm), and back with "Back to PAPER".
TZ_MODE=paper
# Price source. auto (default) = REAL market data, for paper and live alike:
# Alpaca if keys are set, otherwise Coinbase (crypto, no key needed).
# sim = synthetic prices, only for offline demos/tests.
TZ_FEED=auto
# Broker used in PAPER mode: paper (internal simulator) | alpaca (Alpaca paper account)
TZ_BROKER=paper
# Empty = default for the feed (Coinbase: BTC ETH SOL XRP DOGE ADA AVAX LINK LTC DOT; Alpaca: crypto + AAPL NVDA TSLA)
TZ_SYMBOLS=
# Indicators run on bars of this many seconds when trading real data (stops still act on every trade).
# 60 = 1-minute bars, pre-loaded from Coinbase history so trading starts immediately.
TZ_BAR_SECONDS=60
TZ_STARTING_CASH=100000
TZ_CYCLE_SECONDS=1

# Optional access token (a master key for scripts). Not needed to log in: on first visit the site
# asks for the SETUP code printed in the server logs, then you choose a 6-digit PIN.
# If you set one on a public server it must be 16+ random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TZ_API_TOKEN=

# ---- Firewall / abuse protection ----------------------------------------
# Only these IPs/CIDRs may connect (empty = everyone, still behind sign-in)
TZ_ALLOWED_IPS=
TZ_RATE_LIMIT_PER_MIN=600
# Wrong tokens within 15 minutes before an IP is blocked; ban doubles for repeat offenders (max 7 days)
TZ_LOGIN_FAILURES_BEFORE_BAN=5
TZ_BAN_MINUTES=30
# Proxies whose X-Forwarded-For is trusted (set automatically to * on Render)
TZ_TRUSTED_PROXIES=

# ---- App lock (PIN / Face ID, chosen in the dashboard) ----------------------
# Re-lock after this many minutes without activity (it also locks on every app open)
TZ_LOCK_AFTER_MIN=5
# Public address Face ID is bound to (default: the address the browser used)
TZ_PUBLIC_URL=

# ---- Alpaca ------------------------------------------------------------
# Paper-account keys (optional: for TZ_BROKER=alpaca and/or TZ_FEED=alpaca)
TZ_ALPACA_KEY=
TZ_ALPACA_SECRET=
# LIVE (real money) account keys - setting these enables the Go LIVE button
TZ_ALPACA_LIVE_KEY=
TZ_ALPACA_LIVE_SECRET=
# Most USD the bots may trade with in live mode, even if the account holds more (0 = no cap)
TZ_LIVE_MAX_CAPITAL=0

# ---- Trading costs (paper fills charge these; trades must beat them) -------
TZ_CRYPTO_FEE_BPS=25
TZ_STOCK_FEE_BPS=0
TZ_SLIPPAGE_BPS=3
# Skip trades whose target is less than this multiple of the round-trip cost
TZ_MIN_EDGE_COST_MULTIPLE=3

# ---- Executive (head trader) ---------------------------------------------
# Hold an entry if price already moved this many R past the plan (no chasing)
TZ_EXEC_MAX_CHASE_R=0.5
# Hold entries when a symbol's price is older than this many seconds
TZ_EXEC_STALE_AFTER_S=20
# Max same-direction crypto positions at once (they move together)
TZ_EXEC_MAX_CORRELATED=3
# Losses in a row that switch to the defensive stance (half size, conviction 0.45+)
TZ_EXEC_DEFENSIVE_AFTER_LOSSES=3
TZ_EXEC_DEFENSIVE_MIN_STRENGTH=0.45
TZ_EXEC_DEFENSIVE_COOLOFF_MIN=30

# ---- Coach (the team learns from its own trades; hard safety limits never change) ----
TZ_COACH_LEARNING=true
# How long a coin that keeps losing sits out
TZ_COACH_BENCH_MINUTES=120
# Idle this many hours with healthy results -> look a little harder for chances
TZ_COACH_IDLE_HOURS=6

# ---- Autonomy ------------------------------------------------------------
# Daily-loss kill switch re-arms itself at the next UTC day
TZ_AUTO_REARM_DAILY=true
# Restore books, stops and mode (including live, if the broker matches) after a restart
TZ_RESUME_ON_RESTART=true

# ---- Risk Manager ------------------------------------------------------
TZ_RISK_PER_TRADE=0.01
TZ_MAX_POSITION_PCT=0.20
TZ_MAX_GROSS_EXPOSURE=1.0
TZ_MAX_OPEN_POSITIONS=5
TZ_MAX_DAILY_LOSS_PCT=0.05
TZ_MAX_DRAWDOWN_PCT=0.15
TZ_MAX_ORDERS_PER_MINUTE=30
TZ_MIN_SIGNAL_STRENGTH=0.35
TZ_SYMBOL_COOLDOWN_S=10
TZ_ALLOW_SHORT=false
# Buys need team consensus: nobody objects and at least this many voters agree
TZ_CONSENSUS_MIN_YES=2
TZ_FRACTIONAL=true

# Max total loss if every open stop were hit, as a fraction of equity
TZ_MAX_PORTFOLIO_HEAT=0.05

# ---- Stop-loss placement ------------------------------------------------
# structure = just beyond the recent swing low/high (the commonly used level) | atr = fixed ATR multiple
TZ_STOP_METHOD=structure
TZ_STOP_BUFFER_ATR=1.0
TZ_MIN_STOP_ATR=1.5
# Skip trades whose swing stop is wider than this many ATR
TZ_MAX_STOP_ATR=4.0
# Target = this x stop distance; need at least min_room_r of room before resistance
TZ_REWARD_RISK=2.0
TZ_MIN_ROOM_R=1.0

# ---- Portfolio Manager exits ------------------------------------------
TZ_STOP_ATR_MULT=3
TZ_TAKE_PROFIT_ATR_MULT=6
TZ_TRAILING_STOP=true

# ---- Profit protection (a trade that went green must not end red) ----------
# Arm when open profit reaches this multiple of the initial risk; stop moves to break-even + costs
TZ_BREAKEVEN_TRIGGER_R=0.5
# Then lock in this share of the peak open profit
TZ_PROFIT_LOCK_PCT=0.5
# Take partial profit at +1R on half the position (0 disables)
TZ_SCALE_OUT_R=1.0
TZ_SCALE_OUT_FRACTION=0.5
# Strategy-driven exits only when net profitable (stop-losses still cut losers)
TZ_EXIT_ONLY_IN_PROFIT=true

# ---- Grok (xAI) AI analyst --------------------------------------------
TZ_GROK_API_KEY=
TZ_GROK_MODEL=grok-4
# auto = veto when a key is set, else off | veto | advisory | off
TZ_GROK_MODE=auto
TZ_GROK_FAIL_OPEN=false
TZ_GROK_TIMEOUT_S=20
TZ_GROK_MAX_SIGNAL_AGE_S=30

# ---- Execution accuracy -----------------------------------------------
# worse fills pause trading
TZ_MAX_SLIPPAGE_BPS=50

# ---- Wallets / funding ------------------------------------------------
# The desk's own receiving addresses, CHAIN:address, comma-separated
TZ_DEPOSIT_ADDRESSES=
TZ_WITHDRAWAL_COOLDOWN_H=24
TZ_MAX_DAILY_WITHDRAWAL=10000
