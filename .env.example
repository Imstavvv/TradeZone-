# ---- Mode -------------------------------------------------------------
# paper (default, no real money) | live (real money - requires confirmation below)
TZ_MODE=paper
# Price source: sim (synthetic) | coinbase (real crypto prices, no key) | alpaca
TZ_FEED=sim
# Order routing: paper (internal simulator) | alpaca
TZ_BROKER=paper
TZ_SYMBOLS=BTC-USD,ETH-USD,SOL-USD,AAPL,NVDA,TSLA
TZ_STARTING_CASH=100000
TZ_CYCLE_SECONDS=1

# ---- Live trading safety ---------------------------------------------
# Must be exactly this phrase for TZ_MODE=live to start:
# TZ_LIVE_CONFIRM=I UNDERSTAND THE RISKS
# Protect the control API (pause/kill/flatten) - strongly recommended outside localhost
TZ_API_TOKEN=

# ---- Alpaca ------------------------------------------------------------
TZ_ALPACA_KEY=
TZ_ALPACA_SECRET=
TZ_ALPACA_PAPER=true

# ---- Risk Manager ------------------------------------------------------
TZ_RISK_PER_TRADE=0.01
TZ_MAX_POSITION_PCT=0.20
TZ_MAX_GROSS_EXPOSURE=1.0
TZ_MAX_OPEN_POSITIONS=5
TZ_MAX_DAILY_LOSS_PCT=0.05
TZ_MAX_DRAWDOWN_PCT=0.15
TZ_MAX_ORDERS_PER_MINUTE=30
TZ_MIN_SIGNAL_STRENGTH=0.35
TZ_SYMBOL_COOLDOWN_S=10
TZ_ALLOW_SHORT=false
TZ_FRACTIONAL=true

# ---- Portfolio Manager exits ------------------------------------------
TZ_STOP_ATR_MULT=3
TZ_TAKE_PROFIT_ATR_MULT=6
TZ_TRAILING_STOP=true

# ---- Grok (xAI) AI analyst --------------------------------------------
TZ_GROK_API_KEY=
TZ_GROK_MODEL=grok-4
# auto = veto when a key is set, else off | veto | advisory | off
TZ_GROK_MODE=auto
TZ_GROK_FAIL_OPEN=false
TZ_GROK_TIMEOUT_S=20
TZ_GROK_MAX_SIGNAL_AGE_S=30

# ---- Execution accuracy -----------------------------------------------
# worse fills pause trading
TZ_MAX_SLIPPAGE_BPS=50

# ---- Wallets / funding ------------------------------------------------
# The desk's own receiving addresses, CHAIN:address, comma-separated
TZ_DEPOSIT_ADDRESSES=
TZ_WITHDRAWAL_COOLDOWN_H=24
TZ_MAX_DAILY_WITHDRAWAL=10000
