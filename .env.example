# ---- Mode -------------------------------------------------------------
# The desk ALWAYS starts in paper. Switch to live with the dashboard's "Go LIVE" button
# (you type LIVE to confirm), and back with "Back to PAPER".
TZ_MODE=paper
# Price source. auto (default) = REAL market data, for paper and live alike:
# Kraken if your real-money account is Kraken, else Alpaca if keys are set, else Coinbase (crypto, no key).
# kraken | coinbase | alpaca pick one directly.
# sim = synthetic prices, only for offline demos/tests.
TZ_FEED=auto
# Broker used in PAPER mode: paper (internal simulator) | alpaca (Alpaca paper account)
TZ_BROKER=paper
# Empty = default for the feed. Coinbase: BTC ETH SOL XRP AVAX LINK + meme coins DOGE SHIB PEPE BONK WIF FLOKI.
# Alpaca: the same minus BONK/WIF/FLOKI (Alpaca can't trade them). Stocks can be added, e.g. ...,AAPL
TZ_SYMBOLS=
# Trusted meme coins: smaller bets, quick flips, sniped breakouts
TZ_MEME_COINS=DOGE,SHIB,PEPE,BONK,WIF,FLOKI
TZ_MEME_RISK_MULT=0.5
TZ_MAX_MEME_POSITIONS=3
TZ_SNIPE=true
# a live price this far above the recent high triggers a snipe (0.01 = 1%)
TZ_SNIPE_BREAKOUT_PCT=0.01

# ---- Stops and targets ----------------------------------------------------
# percent (default): -TZ_STOP_LOSS_PCT stop, +TZ_TAKE_PROFIT_PCT target | structure | atr
TZ_STOP_METHOD=percent
TZ_STOP_LOSS_PCT=0.08
TZ_TAKE_PROFIT_PCT=0.15
# bigger, calmer coins (BTC, ETH, SOL...) and stocks: a plan they can reach in hours, not days
TZ_MAJOR_STOP_LOSS_PCT=0.03
TZ_MAJOR_TAKE_PROFIT_PCT=0.06
# quick flips: close a trade that went nowhere for this long if it is in profit after fees
TZ_MAX_HOLD_HOURS=24
TZ_MEME_MAX_HOLD_HOURS=6
# Runners: at the target sell this share, move the stop into profit (at least +RUNNER_LOCK) and trail the rest
TZ_RUNNERS=true
TZ_RUNNER_SELL_FRACTION=0.5
# runner stop locks at least this share of the target (0.5 = half: +7.5% on a +15% target)
TZ_RUNNER_LOCK_SHARE=0.5

# ---- Skimmer: quick day-trade skims + profit-taking of every size ----------
TZ_SKIMMER=true
TZ_SKIM_TARGET_PCT=0.025
TZ_SKIM_STOP_PCT=0.012
TZ_SKIM_MAX_MINUTES=120
TZ_MAX_SKIMS=2
# bank TZ_BANK_FRACTION of a trade once it is TZ_BANK_AT_SHARE of the way to its target
TZ_BANK_AT_SHARE=0.5
TZ_BANK_FRACTION=0.25
# sell TZ_SPIKE_FRACTION into a jump of this size within the last 5 bars
TZ_SPIKE_PCT=0.025
TZ_MEME_SPIKE_PCT=0.06
TZ_SPIKE_FRACTION=0.5
# Indicators run on bars of this many seconds when trading real data (stops still act on every trade).
# 60 = 1-minute bars, pre-loaded from Coinbase history so trading starts immediately.
TZ_BAR_SECONDS=60
TZ_STARTING_CASH=100000
TZ_CYCLE_SECONDS=1

# Optional access token (a master key for scripts). Not needed to log in: on first visit the site
# asks for the login code printed in the server logs (no password).
# If you set one on a public server it must be 16+ random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TZ_API_TOKEN=

# ---- Firewall / abuse protection ----------------------------------------
# Only these IPs/CIDRs may connect (empty = everyone, still behind sign-in)
TZ_ALLOWED_IPS=
TZ_RATE_LIMIT_PER_MIN=600
# Wrong tokens within 15 minutes before an IP is blocked; ban doubles for repeat offenders (max 7 days)
TZ_LOGIN_FAILURES_BEFORE_BAN=5
TZ_BAN_MINUTES=30
# Proxies whose X-Forwarded-For is trusted (set automatically to * on Render)
TZ_TRUSTED_PROXIES=

# ---- Uphold (real money) --------------------------------------------------
# Access token: run `python -m tradezone uphold-token`, or connect from the app (Settings -> Linked accounts)
TZ_UPHOLD_TOKEN=
# Uphold's spread per side; practice trades charge this when Uphold is the real-money venue (100 = 1%)
TZ_UPHOLD_FEE_BPS=100
# auto = Uphold if TZ_UPHOLD_TOKEN is set, else Kraken if TZ_KRAKEN_KEY is set, else Alpaca | uphold | kraken | alpaca
TZ_LIVE_VENUE=auto

# ---- Alpaca ------------------------------------------------------------
# Paper-account keys (optional: for TZ_BROKER=alpaca and/or TZ_FEED=alpaca)
TZ_ALPACA_KEY=
TZ_ALPACA_SECRET=
# LIVE (real money) account keys - setting these enables the Go LIVE button
TZ_ALPACA_LIVE_KEY=
TZ_ALPACA_LIVE_SECRET=
# Kraken (real money, crypto) - a key WITHOUT "Withdraw Funds" (TradeZone refuses keys that can withdraw)
TZ_KRAKEN_KEY=
TZ_KRAKEN_SECRET=
# Most USD the bots may trade with in live mode, even if the account holds more (0 = no cap)
TZ_LIVE_MAX_CAPITAL=0
# Growth ladder: smaller coins only under FOCUS_SMALL_UNTIL ($), + mid-size coins under FOCUS_MID_UNTIL, then all
TZ_FOCUS_SMALL_COINS=true
TZ_FOCUS_SMALL_UNTIL=250
TZ_FOCUS_MID_UNTIL=1000
TZ_MAX_SMALL_COINS=8
# Daily goal: profit in USD the bots aim for each day (0 = off). Once reached, giving back 25% stops new trades
TZ_DAILY_GOAL_USD=1000
TZ_DAILY_GOAL_GIVEBACK=0.25
# No ceiling on profits: slices banked early (the rest runs); a slipping good day trades smaller instead of stopping
TZ_FLIP_BANK_FRACTION=0
# Real-money skims at once (0 = off)
TZ_FLIP_MAX_SKIMS=0
TZ_RUNNER_SELL_FRACTION=0.33
TZ_DAY_LOCK_SIZE=0.5
TZ_DAY_LOCK_STOPS=false
# More real-money trades: conviction needed, re-entry while a trend holds, and a wider skim window
TZ_FLIP_MIN_STRENGTH=0.22
TZ_REENTRY_BARS=5
TZ_FLIP_SKIM_RSI_MAX=55
# Trend Scout: meme coins over this market cap with promising volume, and trending coins, plugged in (Kraken prices)
TZ_DISCOVER_COINS=true
TZ_DISCOVERY_MIN_MCAP=50000
TZ_DISCOVERY_MIN_VOLUME=100000
TZ_MAX_DISCOVERED=20
# Flipper: learns the best hours to flip (good hours bigger, bad hours smaller) and flips moves on heavy volume
TZ_FLIPPER=true
TZ_FLIP_VOLUME_RATIO=2.0
TZ_FLIP_MIN_SAMPLES=12
# Accumulate: sell a slice into a rise, buy it back cheaper only if that ends with more coins (after fees)
TZ_ACCUMULATE=false
TZ_ACC_SLICE=0.20
TZ_ACC_RISE_PCT=0.03
TZ_ACC_DIP_PCT=0.025
# Reinvest: this share of today's banked profit is added to the next trades' risk (house money)
TZ_REINVEST_SHARE=0.25
# Stop-loss 33% below the buy price (positions sized so a full stop-out still costs ~risk_per_trade); false = normal plan
TZ_WIDE_STOP=true
TZ_WIDE_STOP_PCT=0.33
# Moving take-profit: every +10% past the buy price moves the target 10% further out and locks half the step
TZ_TP_STEP=true
TZ_TP_STEP_PCT=0.10
TZ_TP_STEP_LOCK=0.5
# Real money: more capital per trade, a wider safety stop, and patient exits (hold a loser for a comeback
# unless momentum AND volume say it isn't coming back)
TZ_LIVE_RISK_PER_TRADE=0.025
TZ_LIVE_MAX_POSITION_PCT=0.35
TZ_PATIENT_EXITS=true
TZ_PATIENT_STOP_PCT=0.05
TZ_PATIENT_MEME_STOP_PCT=0.12
# Real-money risk level: normal | aggressive (about 2x the risk per trade and wider loss limits; see README)
TZ_RISK_PROFILE=normal
# Shorting: auto = only where it works (easy-to-borrow stocks on an Alpaca margin account; never crypto or meme coins) | off
TZ_SHORTING=auto
# The goal: grow fast, lose little. Day lock: once up this much today, giving back this share stops new trades
TZ_DAY_LOCK_TRIGGER_PCT=0.02
TZ_DAY_GIVEBACK_PCT=0.5
# On a day down half the daily limit, new trades are this size
TZ_LOSING_DAY_SIZE=0.5
# Quick flips on real money: more trades, smaller wins banked sooner (always after fees). false = practice plan
TZ_LIVE_QUICK_FLIPS=true
# Kraken's fee per side used for planning and practice (fills report the real fee)
TZ_KRAKEN_FEE_BPS=40
# Real-money buys wait at the bid as a post-only limit (maker fee) for this long, then the rest goes market
TZ_MAKER_ENTRIES=true
TZ_MAKER_WAIT_S=20
# With Kraken prices: add Kraken-listed meme coins that trade at least this much a day (up to TZ_MAX_MEME_COINS)
TZ_KRAKEN_MEMES=true
TZ_MIN_MEME_VOLUME_USD=1000000
TZ_MAX_MEME_COINS=12
# Never buy a coin that can't be sold: max bid/ask gap, min daily trading, max share of a day's trading
TZ_SELL_MAX_SPREAD_PCT=0.015
TZ_SELL_MIN_VOLUME_USD=250000
TZ_SELL_MAX_VOLUME_SHARE=0.01
# What one transfer out costs you (0 = estimate from your cheapest linked wallet's network, else $1)
TZ_CASHOUT_FEE_USD=0
# Every profit-taking sale must make at least this share of one transfer fee
TZ_TRANSFER_FEE_SHARE=0.1

# ---- Trading costs (paper fills charge these; trades must beat them) -------
# default 25 (Alpaca's fee); 100 automatically when Uphold is the real-money account (its spread).
# Uncomment only to override both.
# TZ_CRYPTO_FEE_BPS=25
TZ_STOCK_FEE_BPS=0
TZ_SLIPPAGE_BPS=3
# Skip trades whose target is less than this multiple of the round-trip cost
TZ_MIN_EDGE_COST_MULTIPLE=3

# ---- Executive (head trader) ---------------------------------------------
# Hold an entry if price already moved this many R past the plan (no chasing)
TZ_EXEC_MAX_CHASE_R=0.5
# Hold entries when a symbol's price is older than this many seconds
TZ_EXEC_STALE_AFTER_S=20
# Max same-direction crypto positions at once (they move together)
TZ_EXEC_MAX_CORRELATED=4
# Losses in a row that switch to the defensive stance (half size, conviction 0.45+)
TZ_EXEC_DEFENSIVE_AFTER_LOSSES=3
TZ_EXEC_DEFENSIVE_MIN_STRENGTH=0.45
TZ_EXEC_DEFENSIVE_COOLOFF_MIN=30

# ---- Coach (the team learns from its own trades; hard safety limits never change) ----
TZ_COACH_LEARNING=true
# How long a coin that keeps losing sits out
TZ_COACH_BENCH_MINUTES=120
# Idle this many hours with healthy results -> look a little harder for chances
TZ_COACH_IDLE_HOURS=6

# ---- Autonomy ------------------------------------------------------------
# Daily-loss kill switch re-arms itself at the next UTC day
TZ_AUTO_REARM_DAILY=true
# Restore books, stops and mode (including live, if the broker matches) after a restart
TZ_RESUME_ON_RESTART=true

# ---- Risk Manager ------------------------------------------------------
# each trade risks 1.5% of the balance to its stop; one position is at most 25%; all open stops together 7%
TZ_RISK_PER_TRADE=0.015
TZ_MAX_POSITION_PCT=0.25
TZ_MAX_PORTFOLIO_HEAT=0.07
TZ_MAX_GROSS_EXPOSURE=1.0
TZ_MAX_OPEN_POSITIONS=6
TZ_MAX_DAILY_LOSS_PCT=0.05
TZ_MAX_DRAWDOWN_PCT=0.15
TZ_MAX_ORDERS_PER_MINUTE=30
TZ_MIN_SIGNAL_STRENGTH=0.35
TZ_SYMBOL_COOLDOWN_S=10
# Buys need team consensus: nobody objects and at least this many voters agree
TZ_CONSENSUS_MIN_YES=2
TZ_FRACTIONAL=true

# Max total loss if every open stop were hit, as a fraction of equity
TZ_MAX_PORTFOLIO_HEAT=0.05

# ---- Stop-loss placement ------------------------------------------------
# structure = just beyond the recent swing low/high (the commonly used level) | atr = fixed ATR multiple
TZ_STOP_METHOD=structure
TZ_STOP_BUFFER_ATR=1.0
TZ_MIN_STOP_ATR=1.5
# Skip trades whose swing stop is wider than this many ATR
TZ_MAX_STOP_ATR=4.0
# Target = this x stop distance; need at least min_room_r of room before resistance
TZ_REWARD_RISK=2.0
TZ_MIN_ROOM_R=1.0

# ---- Portfolio Manager exits ------------------------------------------
TZ_STOP_ATR_MULT=3
TZ_TAKE_PROFIT_ATR_MULT=6
TZ_TRAILING_STOP=true

# ---- Profit protection (a trade that went green must not end red) ----------
# Arm when open profit reaches this multiple of the initial risk; stop moves to break-even + costs
TZ_BREAKEVEN_TRIGGER_R=0.5
# Then lock in this share of the peak open profit
TZ_PROFIT_LOCK_PCT=0.5
# Take partial profit at +1R on half the position (0 disables)
TZ_SCALE_OUT_R=1.0
TZ_SCALE_OUT_FRACTION=0.5
# Strategy-driven exits only when net profitable (stop-losses still cut losers)
TZ_EXIT_ONLY_IN_PROFIT=true

# ---- Grok (xAI) AI analyst --------------------------------------------
TZ_GROK_API_KEY=
TZ_GROK_MODEL=grok-4
# auto = veto when a key is set, else off | veto | advisory | off
TZ_GROK_MODE=auto
TZ_GROK_FAIL_OPEN=false
TZ_GROK_TIMEOUT_S=20
TZ_GROK_MAX_SIGNAL_AGE_S=30

# ---- Execution accuracy -----------------------------------------------
# worse fills pause trading
TZ_MAX_SLIPPAGE_BPS=50

# ---- Wallets / funding ------------------------------------------------
# The desk's own receiving addresses, CHAIN:address, comma-separated
TZ_DEPOSIT_ADDRESSES=
TZ_WITHDRAWAL_COOLDOWN_H=24
TZ_MAX_DAILY_WITHDRAWAL=10000
